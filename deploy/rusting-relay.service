# Rusting Raft relay. Install: see docs/relay.md.
[Unit]
Description=Rusting Raft relay server
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/raft-relay --bind 0.0.0.0:27777
Restart=on-failure
RestartSec=2

# No user account, no privileges, no writable filesystem, no devices beyond the basics.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Resource ceilings. Each connection has a reader and, once in a room, a writer thread:
# 1 + 2 x 512 = 1025 threads at the default --max-conns, so keep --max-conns under half of
# TasksMax. Memory worst case: 512 x 256 KiB send queues + 512 x 64 KiB read buffers +
# stacks, about 200 MiB. One fd per connection.
MemoryMax=256M
TasksMax=1100
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
